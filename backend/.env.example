PORT=5000
# Set the deployed frontend origin(s) in production; separate multiple origins with commas.
FRONTEND_ORIGIN=http://localhost:4200
# Set to the externally reachable backend URL in production.
PUBLIC_BACKEND_URL=http://localhost:5000

# Leave blank to use platform defaults; set paths to override.
CLIPFORGE_FFMPEG=
CLIPFORGE_FFPROBE=
CLIPFORGE_PYTHON=
CLIPFORGE_YTDLP=
CLIPFORGE_YTDLP_AUTO_UPDATE=false

# Optional tuning.
CLIPFORGE_WHISPER_MODEL=small
CLIPFORGE_BACKGROUND_BLUR=35
CLIPFORGE_BACKGROUND_BLUR_PASSES=2
CLIPFORGE_EFFECT_INTENSITY=medium
