PORT=5000
FRONTEND_ORIGIN=http://localhost:4200
PUBLIC_BACKEND_URL=http://localhost:5000

# Firebase Admin service account JSON as a single-line JSON string.
# Alternative: set FIREBASE_PROJECT_ID and GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=
PHONE_INDEX_SECRET=replace-with-a-random-secret-at-least-32-characters

# Comma-separated Firebase Auth UIDs allowed to use /api/admin.
ADMIN_UIDS=

# Optional JSON override for default coin products.
# [{"id":"coins-100","coins":100,"priceRupees":49,"label":"100 Coins"}]
COIN_PACKAGES_JSON=

# Razorpay TEST mode credentials. Never commit actual values.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# Existing media tool overrides, when needed.
CLIPFORGE_FFMPEG=C:/ffmpeg/bin/ffmpeg.exe
CLIPFORGE_FFPROBE=C:/ffmpeg/bin/ffprobe.exe
CLIPFORGE_PYTHON=
CLIPFORGE_YTDLP=
