{
  "projectType": "server",
  "setup": [
    {
      "command": "npm",
      "args": [
        "ci"
      ],
      "timeoutSeconds": 600
    }
  ],
  "assertions": [
    {
      "name": "backend-build",
      "kind": "process",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "npm",
      "args": [
        "test"
      ],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "health-endpoint-200",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": [
        "start"
      ],
      "env": {
        "PORT": "5821"
      },
      "url": "http://localhost:5821/api/health",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 60
    },
    {
      "name": "video-health-endpoint-200",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": [
        "start"
      ],
      "env": {
        "PORT": "5821"
      },
      "url": "http://localhost:5821/api/videos/test",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 60
    }
  ]
}
